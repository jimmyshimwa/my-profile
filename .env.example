# Copy to .env.local for local work, and add the same keys in Vercel
# (Project > Settings > Environment Variables).

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only used by `npm run db:seed` on your own machine. Never add it to Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# The one email allowed into /admin.
ADMIN_EMAIL=jimmyshimwa@gmail.com

# Public URL of the site (canonical links, sitemap, OG images, email links).
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
